{
  "name": "dharma",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "description": "Dharma - Full-stack application with NestJS backend and React frontend",
  "private": true,
  "scripts": {
    "dharma": "node tools/cli/dist/index.js",
    "cli:build": "nx run cli:build",
    "cli:dev": "tsx tools/cli/src/index.ts",
    "cli:watch": "tsc -p tools/cli/tsconfig.json --watch",
    "format": "biome format --write .",
    "lint": "nx run-many --target=lint",
    "typecheck": "tsc -b --noEmit",
    "test": "nx run-many --target=test",
    "api:serve": "nx run api:serve:watch",
    "api:start": "nx run api:serve",
    "api:build": "nx run api:build",
    "api:lint": "nx run api:lint",
    "api:test": "nx run api:test",
    "api:codegen": "nx run api:codegen",
    "web:serve": "nx run web:serve",
    "web:build": "nx run web:build",
    "web:lint": "nx run web:lint",
    "web:test": "nx run web:test",
    "web:codegen": "nx run web:codegen",
    "codegen": "nx run-many --target=codegen",
    "db:generate": "nx run api:db-generate",
    "db:push": "nx run api:db-push",
    "db:migrate": "nx run api:db-migrate",
    "db:studio": "nx run api:db-studio",
    "db:seed": "nx run api:db-seed",
    "db:reset": "nx run api:db-reset",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "nestjs",
    "react",
    "graphql",
    "typescript",
    "fullstack"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@nx/js": "^22.0.1",
    "@nx/nest": "^22.0.0",
    "@nx/react": "^22.0.0",
    "@nx/vite": "^22.0.1",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.10.1",
    "@swc/helpers": "^0.5.15",
    "@types/node": "24.9.1",
    "globby": "^16.0.0",
    "nx": "^22.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "7.1.11",
    "@vitest/coverage-v8": "^2.1.5",
    "vitest": "^2.1.5"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.1.12"
    }
  }
}
