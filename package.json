{
  "name": "dharma",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "description": "Dharma - Full-stack application with NestJS backend and React frontend",
  "private": true,
  "scripts": {
    "dharma": "node tools/cli/dist/index.js",
    "cli:build": "nx run cli:build",
    "cli:dev": "tsx tools/cli/src/index.ts",
    "cli:watch": "tsc -p tools/cli/tsconfig.json --watch",
    "format": "biome format --write .",
    "lint": "nx run-many --target=lint",
    "typecheck": "tsc -b --noEmit",
    "test": "nx run-many --target=test",
    "api:serve": "nx run api:serve:watch",
    "api:start": "nx run api:serve",
    "api:build": "nx run api:build",
    "api:lint": "nx run api:lint",
    "api:test": "nx run api:test",
    "api:codegen": "nx run api:codegen",
    "web:serve": "nx run web:serve",
    "web:build": "nx run web:build",
    "web:lint": "nx run web:lint",
    "web:test": "nx run web:test",
    "web:codegen": "nx run web:codegen",
    "codegen": "nx run-many --target=codegen",
    "db:generate": "nx run api:db-generate",
    "db:push": "nx run api:db-push",
    "db:migrate": "nx run api:db-migrate",
    "db:studio": "nx run api:db-studio",
    "db:seed": "nx run api:db-seed",
    "db:reset": "nx run api:db-reset",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "nestjs",
    "react",
    "graphql",
    "typescript",
    "fullstack"
  ],
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@faker-js/faker": "10.1.0",
    "@graphql-codegen/cli": "^6.0.1",
    "@graphql-codegen/typed-document-node": "^6.1.0",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@nx/jest": "^22.0.0",
    "@nx/js": "^22.0.1",
    "@nx/nest": "^22.0.0",
    "@nx/react": "^22.0.0",
    "@nx/vite": "^22.0.1",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.10.1",
    "@swc/helpers": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "24.9.1",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.2",
    "@types/react-router-dom": "5.3.3",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.5",
    "drizzle-kit": "^0.31.5",
    "globby": "^16.0.0",
    "graphql-codegen-typescript-validation-schema": "^0.18.1",
    "jest": "30.2.0",
    "jsdom": "^25.0.1",
    "lightningcss": "^1.30.2",
    "nx": "^22.0.1",
    "supertest": "^7.1.1",
    "ts-jest": "29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "7.1.11",
    "vitest": "^2.1.5"
  }
}
