{
  "name": "dharma",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "description": "Dharma - Full-stack application with NestJS backend and React frontend",
  "private": true,
  "scripts": {
    "dharma": "node tools/cli/dist/index.js",
    "cli:build": "pnpm --filter @dharma/cli run build",
    "cli:dev": "tsx tools/cli/src/index.ts",
    "cli:watch": "tsc -p tools/cli/tsconfig.json --watch",
    "format": "biome format --write .",
    "lint": "biome check --write .",
    "typecheck": "tsc -b apps/api apps/web tools/cli",
    "ci:check": "biome ci .",
    "deps": "pnpm run cli:build && node tools/cli/dist/index.js deps",
    "deps:majors": "pnpm run cli:build && node tools/cli/dist/index.js deps --majors",
    "deps:ci": "pnpm run cli:build && node tools/cli/dist/index.js deps --ci",
    "test": "vitest run",
    "api:serve": "pnpm --filter api run serve",
    "api:start": "pnpm --filter api run serve",
    "api:build": "pnpm --filter api run build",
    "api:lint": "biome check --write apps/api",
    "api:test": "pnpm --filter api run test",
    "api:codegen": "echo 'No API code generation configured.'",
    "web:serve": "pnpm --filter web run serve",
    "web:build": "pnpm --filter web run build",
    "web:lint": "biome check --write apps/web",
    "web:test": "pnpm --filter web run test",
    "web:codegen": "pnpm --filter web run codegen",
    "codegen": "pnpm run api:codegen && pnpm run web:codegen",
    "db:generate": "tsc -b apps/api/tsconfig.app.json && drizzle-kit generate --config=apps/api/drizzle.config.cjs",
    "db:push": "tsc -b apps/api/tsconfig.app.json && drizzle-kit push --force --config=apps/api/drizzle.config.cjs",
    "db:migrate": "tsc -b apps/api/tsconfig.app.json && drizzle-kit migrate --config=apps/api/drizzle.config.cjs",
    "db:studio": "tsc -b apps/api/tsconfig.app.json && drizzle-kit studio --config=apps/api/drizzle.config.cjs",
    "db:seed": "npx tsx apps/api/src/db/seed.ts",
    "db:reset": "tsc -b apps/api/tsconfig.app.json && drizzle-kit drop --config=apps/api/drizzle.config.cjs && drizzle-kit push --force --config=apps/api/drizzle.config.cjs && npx tsx apps/api/src/db/seed.ts",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "nestjs",
    "react",
    "graphql",
    "typescript",
    "fullstack"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@faker-js/faker": "10.1.0",
    "@graphql-codegen/cli": "^6.0.1",
    "@graphql-codegen/typed-document-node": "^6.1.0",
    "@graphql-codegen/typescript": "^5.0.2",
    "@graphql-codegen/typescript-operations": "^5.0.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.10.1",
    "@swc/helpers": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/prompts": "catalog:",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.2",
    "@types/react-router-dom": "5.3.3",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.5",
    "drizzle-kit": "^0.31.5",
    "globby": "^16.0.0",
    "jsdom": "^25.0.1",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.11",
    "vite": "7.1.11",
    "vitest": "^2.1.5"
  }
}
