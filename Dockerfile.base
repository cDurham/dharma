# Dockerfile for base image with pre-installed dependencies
# This speeds up builds significantly when dependencies haven't changed
# Build with: docker build -f Dockerfile.base -t ghcr.io/<repo>/dharma-base:latest .

FROM node:22-slim AS base
WORKDIR /workspace

# Copy package files and install ALL dependencies (for dev/build stages)
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline --legacy-peer-deps

# Create a production-only dependencies layer
FROM node:22-slim AS base-prod
WORKDIR /workspace
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --only=production --prefer-offline --legacy-peer-deps

# Multi-stage output so both can be referenced
FROM base AS final-dev
FROM base-prod AS final-prod

