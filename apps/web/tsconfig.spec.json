{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/apps/web-tests",
    "types": [
      "vite/client",
      "vitest/globals",
      "vitest/importMeta",
      "@testing-library/jest-dom"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.spec.ts"
  ],
  "exclude": [
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
