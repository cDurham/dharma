{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -b tsconfig.app.json && find src -name '*.graphql' -exec sh -c 'mkdir -p ../../dist/apps/api/$(dirname {}) && cp {} ../../dist/apps/api/{}' \\;",
    "serve": "pnpm run build && sh -c 'tsc -b tsconfig.app.json --watch --preserveWatchOutput & node --watch --enable-source-maps ../../dist/apps/api/src/index.js'",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "chalk": "catalog:",
    "commander": "catalog:",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "graphql": "^17.0.2",
    "graphql-http": "^1.23.0",
    "graphql-scalars": "^2.0.0",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.5",
    "ora": "catalog:",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prompts": "catalog:",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "yaml": "catalog:",
    "zod": "^4.4.3"
  }
}
