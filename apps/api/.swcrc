{
    "jsc": {
      "parser": {
        "syntax": "typescript",
        "decorators": true
      },
      "transform": {
        "legacyDecorator": true,
        "decoratorMetadata": true
      },
      "target": "es2022",
      "externalHelpers": true,
      "keepClassNames": true
    },
    "module": {
      "type": "es6"
    },
    "sourceMaps": true
  }