{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/api",
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "module": "ESNext",
    "target": "ES2022"
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**",
    "**/__test__/**"
  ],
  "include": ["src/**/*.ts", "drizzle.config.ts"]
}
