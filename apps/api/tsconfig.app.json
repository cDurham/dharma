{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "incremental": true,
    "noEmitOnError": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../../dist/apps/api",
    "target": "ES2022",
    "types": ["node"],
    "verbatimModuleSyntax": true
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**",
    "**/__test__/**"
  ],
  "include": ["src/**/*.ts", "drizzle.config.ts"]
}
