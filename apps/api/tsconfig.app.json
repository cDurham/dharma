{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc/apps/api",
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "module": "ESNext",
    "target": "ES2022"
  },
  "exclude": [
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/__test__/**"
  ],
  "include": [
    "src/**/*.ts",
    "drizzle.config.ts",
    "jest.config.ts"
  ]
}
