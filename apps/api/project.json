{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -b tsconfig.app.json",
          "sh -c 'tsc -b tsconfig.app.json --watch --preserveWatchOutput & node --watch --enable-source-maps ../../dist/apps/api/src/index.js'"
        ],
        "parallel": false,
        "cwd": "apps/api"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{workspaceRoot}/dist/apps/api"
      ],
      "options": {
        "main": "apps/api/src/index.ts",
        "outputPath": "dist/apps/api",
        "tsConfig": "apps/api/tsconfig.app.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write {projectRoot}"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{workspaceRoot}/coverage/api"
      ],
      "options": {
        "configFile": "apps/api/vitest.config.ts"
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No API code generation configured.'"
      }
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -b apps/api/tsconfig.app.json",
          "drizzle-kit generate --config=apps/api/drizzle.config.cjs"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "db-push": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -b apps/api/tsconfig.app.json",
          "drizzle-kit push --force --config=apps/api/drizzle.config.cjs"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "db-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -b apps/api/tsconfig.app.json",
          "drizzle-kit migrate --config=apps/api/drizzle.config.cjs"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "db-studio": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -b apps/api/tsconfig.app.json",
          "drizzle-kit studio --config=apps/api/drizzle.config.cjs"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "db-drop": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -b apps/api/tsconfig.app.json",
          "drizzle-kit drop --config=apps/api/drizzle.config.cjs"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "db-reset": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -b apps/api/tsconfig.app.json",
          "drizzle-kit drop --config=apps/api/drizzle.config.cjs && drizzle-kit push --force --config=apps/api/drizzle.config.cjs && npx tsx apps/api/src/db/seed.ts"
        ],
        "parallel": false,
        "cwd": "."
      }
    },
    "db-seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx apps/api/src/db/seed.ts",
        "cwd": "."
      }
    }
  }
}