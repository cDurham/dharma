{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "api:build",
        "watch": true,
        "buildTargetOptions": { "watch": true }
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/api",
        "main": "apps/api/src/index.ts",
        "tsConfig": "apps/api/tsconfig.app.json",
        "assets": [
          "apps/api/src/**/*.graphql"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/api/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/api"],
      "options": {
        "jestConfig": "apps/api/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'No API code generation configured.'"
      }
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit generate --config=apps/api/drizzle.config.ts",
        "cwd": "."
      }
    },
    "db-push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit push --force --config=apps/api/drizzle.config.ts",
        "cwd": "."
      }
    },
    "db-migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit migrate --config=apps/api/drizzle.config.ts",
        "cwd": "."
      }
    },
    "db-studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit studio --config=apps/api/drizzle.config.ts",
        "cwd": "."
      }
    },
    "db-drop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit drop --config=apps/api/drizzle.config.ts",
        "cwd": "."
      }
    },
    "db-reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit drop --config=apps/api/drizzle.config.ts && drizzle-kit push --force --config=apps/api/drizzle.config.ts && npx tsx apps/api/src/db/seed.ts",
        "cwd": "."
      }
    },
    "db-seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx apps/api/src/db/seed.ts",
        "cwd": "."
      }
    }
  }
}
