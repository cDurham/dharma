# syntax=docker/dockerfile:1.6
# Optimized Dockerfile that uses pre-built base images for faster builds
# Requires base images to be built first via build-base-image.yml workflow

ARG BASE_IMAGE_REGISTRY=ghcr.io/cdurham/dharma

# Use pre-built base images with dependencies already installed
FROM ${BASE_IMAGE_REGISTRY}/dharma-base:latest AS deps
WORKDIR /workspace

FROM ${BASE_IMAGE_REGISTRY}/dharma-base-prod:latest AS deps-prod
WORKDIR /workspace

# Development targets
FROM deps AS dev_api
COPY . .
EXPOSE 3000 9229
CMD ["npm", "run", "api:serve"]

FROM deps AS dev_web
COPY . .
EXPOSE 4200
CMD ["npm", "run", "web:serve"]

# Build targets
FROM deps AS build_api
ARG CACHEBUST
RUN echo "Cache bust: ${CACHEBUST}"
COPY . .
RUN npm run api:build

FROM deps AS build_web
ARG CACHEBUST
RUN echo "Cache bust: ${CACHEBUST}"
COPY . .
RUN npm run web:build

# Production runtime targets
FROM node:22-slim AS runtime_api
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build_api /workspace/dist/apps/api ./dist/apps/api
COPY --from=deps-prod /workspace/node_modules ./node_modules
EXPOSE 3000
CMD ["node", "dist/apps/api/index.js"]

FROM nginx:1.27-alpine AS runtime_web
COPY --from=build_web /workspace/dist/apps/web /usr/share/nginx/html

