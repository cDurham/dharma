# Database Configuration
# PostgreSQL connection settings
DB_DATABASE=dharma_db
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_ACCESS_TOKEN_EXPIRES_IN=900  # Duration in seconds (900s = 15 minutes)
JWT_ACCESS_TOKEN_MAX_AGE_MS=900000  # Duration in milliseconds (900000ms = 15 minutes)
JWT_REFRESH_TOKEN_EXPIRES_IN_DAYS=30
JWT_REFRESH_TOKEN_MAX_AGE_MS=2592000000  # Duration in milliseconds (30 days)

# Cookie Configuration
COOKIE_SECRET=your_cookie_secret_here_change_in_production
COOKIE_ACCESS_TOKEN_MAX_AGE_MS=900000
COOKIE_REFRESH_TOKEN_MAX_AGE_MS=604800000

# Email Configuration
# Gmail SMTP (requires App Password, not your regular Gmail password)
# Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_USER_PASSWORD=your_gmail_app_password_here

# Backend URL (used for email verification links)
BACKEND_URL=http://localhost:3000

# Kafka Configuration
KAFKA_CLIENT_ID=dharma-backend
KAFKA_BROKERS=localhost:9092

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4200

# Environment
NODE_ENV=development 
