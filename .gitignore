# Generated by GraphQL autoSchemaFile on API boot
apps/api/src/schema.gql

# pnpm is the only package manager here (see package.json `packageManager`).
# Stray npm/yarn locks resolve a *different* dependency graph than CI and Docker.
package-lock.json
yarn.lock
# pnpm workspaces have exactly one lockfile, at the root.
apps/*/pnpm-lock.yaml
tools/*/pnpm-lock.yaml
packages/*/pnpm-lock.yaml
*.tsbuildinfo
